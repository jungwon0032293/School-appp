{
  "expo": {
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "androidStatusBar": {
      "hidden": true,
      "translucent": true,
      "backgroundColor": "#ffffff"
    },
    "name": "육민관고등학교",
    "slug": "schoolapp",
    "scheme": "schoolapp",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ymk.schoolapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIStatusBarHidden": true
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.ymk.schoolapp"
        ]
      }
    },
    "android": {
      "package": "com.ymk.schoolapp",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser",
      "expo-notifications",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fed60b27-4d69-474a-9b90-f14f5864e489"
      }
    },
    "owner": "celline0803"
  }
}
